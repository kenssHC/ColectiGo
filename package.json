{
  "name": "collectigo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "backend": "pnpm --filter backend dev",
    "mobile": "pnpm --filter mobile start:dev",
    "mobile:go": "pnpm --filter mobile start:go",
    "mobile:android": "pnpm --filter mobile android",
    "legal:build": "pnpm --filter @collectigo/shared build && node --env-file=apps/mobile/.env scripts/generate-legal-site.mjs",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
