NODE_ENV: production

# Reemplaza REPLACE_WITH_GCP_PROJECT_ID por el ID real de Google Cloud. Debe coincidir con la
# instancia asociada al servicio mediante --add-cloudsql-instances.
DATABASE_SOCKET: /cloudsql/REPLACE_WITH_GCP_PROJECT_ID:southamerica-west1:collectigo-postgres
DATABASE_PORT: '5432'
DATABASE_USER: collectigo_app
DATABASE_NAME: collectigo
# Con max-instances=3, limita la API a unas 12 conexiones simultáneas.
DATABASE_POOL_SIZE: '4'
DATABASE_SSL: 'false'
DATABASE_SSL_REJECT_UNAUTHORIZED: 'true'

FIREBASE_PROJECT_ID: REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL: REPLACE_WITH_FIREBASE_ADMIN_CLIENT_EMAIL
GOOGLE_AUTH_WEB_CLIENT_ID: REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_ID

# La app móvil nativa no depende de CORS, pero producción exige una lista
# explícita para cualquier cliente web o página administrativa futura.
CORS_ORIGINS: https://REPLACE_WITH_FIREBASE_HOSTING_SITE_ID.web.app

WALK_ROUTING_PROVIDER: google

SMTP_HOST: smtp.resend.com
SMTP_PORT: '465'
SMTP_SECURE: 'true'
SMTP_REQUIRE_TLS: 'true'
SMTP_USER: resend
SMTP_FROM: 'ColectiGO <REPLACE_WITH_VERIFIED_RESEND_FROM_ADDRESS>'
ROUTE_SUGGESTIONS_EMAIL: REPLACE_WITH_REAL_SUGGESTIONS_INBOX
