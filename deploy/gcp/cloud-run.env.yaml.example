NODE_ENV: production

# Reemplaza PROJECT_ID por el ID real de Google Cloud. Debe coincidir con la
# instancia asociada al servicio mediante --add-cloudsql-instances.
DATABASE_SOCKET: /cloudsql/PROJECT_ID:southamerica-west1:collectigo-db
DATABASE_PORT: '5432'
DATABASE_USER: collectigo
DATABASE_NAME: collectigo
# Con max-instances=3, limita la API a unas 12 conexiones simultáneas.
DATABASE_POOL_SIZE: '4'
DATABASE_SSL: 'false'
DATABASE_SSL_REJECT_UNAUTHORIZED: 'true'

FIREBASE_PROJECT_ID: PROJECT_ID_FIREBASE
FIREBASE_CLIENT_EMAIL: firebase-adminsdk@PROJECT_ID_FIREBASE.iam.gserviceaccount.com
GOOGLE_AUTH_WEB_CLIENT_ID: REEMPLAZAR.apps.googleusercontent.com

# La app móvil nativa no depende de CORS, pero producción exige una lista
# explícita para cualquier cliente web o página administrativa futura.
CORS_ORIGINS: https://legal.example.com

WALK_ROUTING_PROVIDER: google

SMTP_HOST: smtp.resend.com
SMTP_PORT: '465'
SMTP_SECURE: 'true'
SMTP_REQUIRE_TLS: 'true'
SMTP_USER: resend
SMTP_FROM: ColectiGO <no-reply@mail.example.com>
ROUTE_SUGGESTIONS_EMAIL: sugerencias@example.com
