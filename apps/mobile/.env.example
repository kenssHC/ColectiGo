# URL del backend. Desde un dispositivo físico usa la IP LAN de tu PC,
# por ejemplo: http://192.x.x.x:3000/api/v1
EXPO_PUBLIC_API_URL=

# Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth 2.0 Client ID de tipo Web usado para solicitar un ID token de Google.
# Es un identificador público, no un client secret. Debe coincidir con
# GOOGLE_AUTH_WEB_CLIENT_ID del backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Solo para compilar iOS: REVERSED_CLIENT_ID del OAuth Client ID de iOS.
# Android no necesita esta variable cuando usa el Web Client ID explícito.
GOOGLE_IOS_URL_SCHEME=

# Clave nativa para Google Maps en builds Android propios.
# Habilita "Maps SDK for Android" y restringe la clave por package + SHA-1.
# No usa prefijo EXPO_PUBLIC_: solo se consume al generar la configuración nativa.
GOOGLE_MAPS_API_KEY=

# Entorno funcional de la app.
EXPO_PUBLIC_APP_ENV=development

# Información pública de cumplimiento. Estos valores se muestran dentro de la app
# y no son secretos. En producción también deben configurarse en el entorno EAS.
# Guarda el nombre legal real solo en tu .env ignorado y en el entorno EAS.
EXPO_PUBLIC_LEGAL_RESPONSIBLE_NAME=
EXPO_PUBLIC_PRIVACY_EMAIL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Google Play requiere una política HTML pública y una página web externa para
# solicitar la eliminación de cuenta. Ambas URLs deben usar HTTPS.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
