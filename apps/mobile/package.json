    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
