PORT=3000
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=collectigo
# Máximo de conexiones PostgreSQL por proceso. En Cloud Run con db-f1-micro usa 4.
DATABASE_POOL_SIZE=10

# Cloud Run + Cloud SQL: directorio del socket Unix montado por la plataforma.
# Si se define, reemplaza DATABASE_HOST. Ejemplo:
# /cloudsql/mi-proyecto:southamerica-west1:collectigo-db
DATABASE_SOCKET=

# Alternativa para proveedores administrados. Si se define, DATABASE_URL tiene
# prioridad sobre los cinco campos anteriores.
DATABASE_URL=

# En Cloud SQL, el socket ya viaja cifrado por Cloud SQL Auth Proxy y debe usar
# DATABASE_SSL=false. Estas opciones TLS se conservan para conexiones TCP y
# otros proveedores administrados.

# Activa TLS para PostgreSQL cuando el proveedor lo exija. La verificación del
# certificado permanece activa en producción. Si el proveedor entrega una CA,
# pégala en DATABASE_SSL_CA conservando los saltos como \n.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OAuth 2.0 Client ID de tipo Web. Se usa como audience al verificar
# criptográficamente los ID tokens de Google. No es una API key de Maps.
GOOGLE_AUTH_WEB_CLIENT_ID=

# Orígenes permitidos para CORS, separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=*

# Proveedor de recorridos peatonales: osrm, google o none.
# En desarrollo puede usarse el OSRM público. En producción se exige Google
# Routes API o un OSRM propio/proveedor con HTTPS.
WALK_ROUTING_PROVIDER=osrm
WALK_ROUTING_URL=https://routing.openstreetmap.de/routed-foot

# Key server-side exclusiva del backend, con "Routes API" habilitada y
# facturación activa. Restríngela a Routes API y, al desplegar, a las IP del
# servidor. No reutilices aquí la key Android incluida en el APK.
# Sin esta key, el tiempo se estima localmente por distancia y hora punta.
GOOGLE_ROUTES_API_KEY=

# Envío de sugerencias de rutas. Usa las credenciales SMTP únicamente en el backend.
# SMTP_SECURE=true suele usarse con el puerto 465; para 587 normalmente es false.
ROUTE_SUGGESTIONS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ColectiGO <no-reply@dominio.com>
