PORT=3000
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=collectigo

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Orígenes permitidos para CORS, separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=*

# Servidor OSRM (perfil peatonal) para trazar caminatas por las calles.
# Por defecto usa el servidor público de OpenStreetMap. Déjalo vacío para
# desactivarlo y usar líneas rectas.
# WALK_ROUTING_URL=https://routing.openstreetmap.de/routed-foot

# API key de Google con "Routes API" habilitada (requiere facturación activa
# en Google Cloud). Se usa para calcular la duración del tramo en vehículo
# con tráfico en tiempo real. Sin key, se estima por hora punta.
GOOGLE_MAPS_API_KEY=
